import Joi from 'joi';

const schema = Joi.object({
    username: Joi.string().alphanum().min(3).max(30).required(),
    email: Joi.string().email().required(),
    age: Joi.number().integer().min(18),
});

const { error, value } = schema.validate({
    username: 'danilo',
    email: 'danilo@example.com',
    age: 28,
});