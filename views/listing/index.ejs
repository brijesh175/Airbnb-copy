<% layout("/layouts/boilerplate") %>

    <body>
        <h2>all listing</h2>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1"> 
            <% for(list of listing){ %>
               <a href="/listing/<%=list._id %>" class="show-link">
                 <div class="card card1">
                    <img src="<%=list.image.url%>" class="card-img-top pics" alt="image of place">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <h6 class="card-title">
                            <%=list.title %>
                        </h6>
                        <p class="card-text">&#8377 <%= list.price.toLocaleString("en-IN") %> /night</p>
                    </div>
                </div>
               </a>
                <% } %>
        </div>
    </body>